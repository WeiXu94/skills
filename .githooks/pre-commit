#!/usr/bin/env bash
#
# pre-commit — refresh vendored upstream skills before each commit (this repo).
#
# Enabled per-project via:  git config core.hooksPath .githooks
# (run that once in any fresh clone; it is local config, not shared by git.)
#
# Pulls upstream and stages the synced skill folders so updates ride along with
# your commit. Network is required; if the sync fails (e.g. offline) the commit
# proceeds unchanged. Bypass entirely with:  git commit --no-verify

set -uo pipefail
root="$(git rev-parse --show-toplevel)"

echo "pre-commit: syncing upstream skills…"
if "$root/scripts/sync-upstream-skills.sh" --stage; then
  :
else
  echo "pre-commit: upstream sync skipped (failed or offline); committing as-is." >&2
fi
exit 0
