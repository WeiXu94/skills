# link-skills: symlink a skill into a project (or user-level) agent dir(s), by name.
# Skills live under ~/skills/skills/: mine in mine/<name>, vendored ones in
# vendor/<source>/<name> (e.g. vendor/mattpocock/<name>). You give only the NAME;
# the location is resolved automatically (mine/ or one vendor source deep).
# Usage: link-skills [-g|--global] [--agent <a>[,<b>...]]... <skill-name>
#   -g, --global    link into ~/ (user-level: ~/.claude, ~/.agents) instead of $PWD
#   --agent <list>  target agent(s); comma- or slash-separated, and/or repeated
#                   (e.g. --agent claude,codex  or  --agent claude --agent codex)
# Agents: pi, codex, opencode -> .agents/skills | claude -> .claude/skills
# Default agents when none given: claude codex
# Examples:
#   link-skills netnewswire-cli                       # project, defaults to claude + codex
#   link-skills --agent claude writing-shape          # project, single agent
#   link-skills -g --agent claude,codex econ-paper-writing  # user-level, both agents
setopt local_options null_glob

# Parse all args in one pass: -g/--global, --agent (repeatable, comma/slash list),
# and the sole bare word is the skill name. Agents come only via --agent.
local base="$PWD"
local skill_name=""
local -a agents
while [[ $# -gt 0 ]]; do
    case "$1" in
        -g|--global) base="$HOME"; shift ;;
        --agent)
            shift
            [[ $# -gt 0 ]] || { echo "Error: --agent needs a value"; return 1; }
            agents+=(${(s:,:)${1//\//,}}); shift ;;
        --agent=*)
            agents+=(${(s:,:)${${1#--agent=}//\//,}}); shift ;;
        -h|--help)
            echo "Usage: link-skills [-g|--global] [--agent <a>[,<b>...]]... <skill-name>"
            echo "  -g, --global    link into ~/ (user-level) instead of the current project"
            echo "  --agent <list>  target agent(s); comma/slash-separated and/or repeatable"
            echo "Agents: pi, codex, opencode (-> .agents/skills), claude (-> .claude/skills)"
            echo "Default agents when none given: claude codex"
            return 0 ;;
        -*) echo "Error: unknown option '$1'"; return 1 ;;
        *)
            if [[ -z "$skill_name" ]]; then
                skill_name="$1"; shift
            else
                echo "Error: unexpected argument '$1' (target agents with --agent <name>)"; return 1
            fi ;;
    esac
done

if [[ -z "$skill_name" ]]; then
    echo "Usage: link-skills [-g|--global] [--agent <a>[,<b>...]]... <skill-name>"
    echo "Agents: pi, codex, opencode (-> .agents/skills), claude (-> .claude/skills)"
    echo "Default agents when none given: claude codex"
    return 1
fi

# Resolve the skill by name: ~/skills/skills/mine/<name> or
# ~/skills/skills/vendor/<source>/<name>.
local skills_root="$HOME/skills/skills"
local m
local -a matches
for m in "$skills_root/mine/$skill_name" "$skills_root/vendor"/*/"$skill_name"; do
    [[ -d "$m" && -f "$m/SKILL.md" ]] && matches+=("$m")
done

if (( ${#matches} == 0 )); then
    echo "Error: skill '$skill_name' not found under $skills_root/mine/ or $skills_root/vendor/*/"
    return 1
fi

local skill_src="${matches[1]}"
if (( ${#matches} > 1 )); then
    # On a name clash, prefer mine/ (your fork wins over a vendored copy);
    # otherwise fall back to the first match.
    [[ -f "$skills_root/mine/$skill_name/SKILL.md" ]] && skill_src="$skills_root/mine/$skill_name"
    echo "Note: multiple skills named '$skill_name':"
    printf '  %s\n' "${matches[@]}"
    echo "Using: $skill_src"
fi

# De-dup agents; default to claude codex when none were given.
agents=(${(u)agents})
(( ${#agents} )) || agents=(claude codex)

# Map agent to its skills subdirectory under $base ($PWD, or ~/ with -g), then
# link (link name = bare skill name, so it sits one level deep where the agent
# can discover it).
local agent agent_dir
for agent in "${agents[@]}"; do
    case "$agent" in
        pi|codex|opencode)  agent_dir=".agents/skills" ;;
        claude)             agent_dir=".claude/skills" ;;
        *)
            echo "Error: unknown agent '$agent'. Use: pi, codex, opencode, claude"
            return 1
            ;;
    esac

    local target_dir="$base/$agent_dir"
    mkdir -p "$target_dir"

    local link="$target_dir/$skill_name"
    if [[ -L "$link" || -e "$link" ]]; then
        echo "Removing existing: $link"
        rm -rf "$link"
    fi

    ln -s "$skill_src" "$link"
    echo "Linked $skill_src -> $link"
done
