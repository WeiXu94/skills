# use-skill-profile: link a named SET of skills (a "profile") into a project (or -g user-level),
# toggling the whole set with one command. A profile is a file under ~/skills/profiles/<name>
# listing skill names one per line (# comments and blank lines ignored). Skill resolution is
# delegated to link-skills, so a bare name resolves across source groups (mine/ wins on a clash).
#
# The `common` profile, if it exists, is ALWAYS unioned in (disable with --no-common).
#
# Usage: use-skill-profile [-g|--global] [--add] [--no-common] <profile> [<profile>...] [-- agent ...]
#   -g, --global    link into ~/ (user-level: ~/.claude, ~/.agents) instead of $PWD
#   --add           STACK onto whatever is already linked (skip the clear step)
#   --no-common     do not auto-include the `common` profile
#   -- agent ...    target agents (default: claude codex)
#
# Default (no --add) is REPLACE: existing ~/skills symlinks are cleared first, so switching
# profiles leaves the project clean. Note: --add aside, this also removes one-off skills you
# linked manually with link-skills — re-add them, or list them in a profile.
#
# Examples:
#   use-skill-profile econ                       # project: econ + common
#   use-skill-profile programming                # project: programming + common
#   use-skill-profile programming econ           # union both (+ common)
#   use-skill-profile --add lit-review-assistant # (a profile named that) stack without clearing
#   use-skill-profile -g programming             # user-level default set
#   use-skill-profile econ -- claude             # only the claude agent dir
setopt local_options null_glob

local base="$PWD"
integer add=0 nocommon=0
local -a profiles agents
while [[ $# -gt 0 ]]; do
    case "$1" in
        -g|--global) base="$HOME"; shift ;;
        --add)       add=1; shift ;;
        --no-common) nocommon=1; shift ;;
        --)          shift; agents=("$@"); break ;;
        -h|--help)
            echo "Usage: use-skill-profile [-g|--global] [--add] [--no-common] <profile>... [-- agent ...]"
            echo "Profiles live in ~/skills/profiles/. The 'common' profile is always included (--no-common to skip)."
            echo "Default is REPLACE (clears existing ~/skills links first); --add stacks instead."
            return 0 ;;
        -*) echo "Error: unknown option '$1'"; return 1 ;;
        *)  profiles+=("$1"); shift ;;
    esac
done
(( ${#agents} )) || agents=(claude codex)

if (( ${#profiles} == 0 )); then
    echo "Usage: use-skill-profile [-g|--global] [--add] [--no-common] <profile>... [-- agent ...]"
    echo "Available profiles:"; print -l ~/skills/profiles/*(:t) 2>/dev/null | sed 's/^/  /'
    return 1
fi

# Always union in `common` (unless suppressed or already named).
if (( ! nocommon )) && [[ -f "$HOME/skills/profiles/common" ]] && (( ${profiles[(Ie)common]} == 0 )); then
    profiles+=(common)
fi

# Collect (deduped) skill names from each profile file.
local -a skills
local -A seen
local p f line s
for p in "${profiles[@]}"; do
    f="$HOME/skills/profiles/$p"
    if [[ ! -f "$f" ]]; then
        echo "Error: profile '$p' not found at $f"
        echo "Available:"; print -l ~/skills/profiles/*(:t) 2>/dev/null | sed 's/^/  /'
        return 1
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"                         # strip trailing comment
        line="${line#"${line%%[![:space:]]*}"}"    # ltrim
        line="${line%"${line##*[![:space:]]}"}"    # rtrim
        [[ -z "$line" ]] && continue
        [[ -n "${seen[$line]}" ]] && continue
        seen[$line]=1
        skills+=("$line")
    done < "$f"
done

local -a gflag=()
[[ "$base" == "$HOME" ]] && gflag=(-g)

# REPLACE: clear first so stale skills from a previous profile don't linger.
if (( ! add )); then
    clear-skills "${gflag[@]}" -- "${agents[@]}"
fi

# Link each skill via link-skills (reuses its name resolution + clash handling).
for s in "${skills[@]}"; do
    link-skills "${gflag[@]}" "$s" "${agents[@]}"
done

echo "Applied profile(s): ${profiles[*]}  ->  ${#skills} skill(s), agents: ${agents[*]}  (base: $base)"
